{
    "version": 2,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/robots.txt",
            "destination": "/robots.txt"
        },
        {
            "source": "/sitemap.xml",
            "destination": "/sitemap.xml"
        },
        {
            "source": "/google285c8dba93d0e59c.html",
            "destination": "/google285c8dba93d0e59c.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}